            </div>

            <div className="space-y-2">
              <Label htmlFor="department">Département</Label>
              <Input
                id="department"
                placeholder="IT, Marketing, Finance..."
                value={formData.department}
                onChange={(e) => handleChange('department', e.target.value)}
                disabled={isLoading}
              />
