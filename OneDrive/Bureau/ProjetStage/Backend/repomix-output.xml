// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // <-- Bien spécifier MySQL
  url      = env("DATABASE_URL")
}

// Modèle Utilisateur basé sur les besoins de signup/signin et les rôles
model User {
  id               String    @id @default(uuid()) @db.VarChar(36) // UUID pour MySQL
  email            String    @unique @db.VarChar(255) // Email unique pour la connexion
  passwordHash     String    @db.VarChar(255) // Hachage du mot de passe
  role             String    @db.VarChar(50) // 'admin', 'supervisor', 'team_member', 'client_contact'
  firstName        String    @db.VarChar(255) // Ajout pour correspondance frontend
  lastName         String    @db.VarChar(255) // Ajout pour correspondance frontend
  phoneNumber      String?   @db.VarChar(50)  // Rendre optionnel si non requis pour tous les rôles au signup
  position         String?   @db.VarChar(255) // Optional fields from frontend
  department       String?   @db.VarChar(255) // Optional fields from frontend
  companyId        String?   @map("company_id") @db.VarChar(36) // FK to Company (optional for now)
  joinDate         DateTime  @default(now()) @db.DateTime(3)
  avatarUrl        String?   @db.VarChar(255) // Optional
  bio              String?   @db.Text         // Use Text for potentially long strings
  skills           String[]  @default([]) // MySQL JSON type (requires >= 5.7)
  certifications   String[]  @default([]) // MySQL JSON type
  languages        String[]  @default([]) // MySQL JSON type

  // Ajoutez d'autres champs si nécessaires et leurs types MySQL
  // Ex: isAvailable Boolean? @default(true) pour les docteurs/infirmières

  // Relations (nous les ajouterons plus tard pour Projets, Tâches, etc.)
  company          Company?  @relation("CompanyUsers", fields: [companyId], references: [id])

  // Liens vers d'autres modèles (à décommenter et ajuster au fur et à mesure)
  // supervisedProjects Project[] @relation("ProjectSupervisor")
  // assignedTasks      Task[]    @relation("TaskAssignees")
  // organizedMeetings  Meeting[] @relation("MeetingOrganizer")
  // participatedMeetings Meeting[] @relation("MeetingParticipants")
  // participatedEvents Event[] @relation("EventParticipants")
  // uploadedAttachments Attachment[]
  // comments           Comment[]
  // ... autres relations ...

  @@index([companyId]) // Index pour la clé étrangère (bonne pratique)
  @@map("users") // Nom de la table dans la base de données
}

// Modèle Company (minimal pour la relation avec User si applicable)
model Company {
   id                 String    @id @default(uuid()) @db.VarChar(36)
   name               String    @unique @db.VarChar(255)
   // Ajoutez d'autres champs de Company ici si nécessaire
   users              User[]    @relation("CompanyUsers")

   @@map("companies")
}

// Ajoutez d'autres modèles (Project, Task, etc.) ici au fur et à mesure
