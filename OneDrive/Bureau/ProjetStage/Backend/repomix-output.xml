// src/controllers/authController.ts
import { Request, Response } from 'express';
import bcrypt from 'bcrypt'; // Pour hacher/comparer les mots de passe
import jwt from 'jsonwebtoken'; // Pour générer les tokens JWT
import prisma from '../config/prismaClient'; // Notre instance du client Prisma
import 'dotenv/config'; // Assurez-vous que process.env.JWT_SECRET est chargé ici aussi si ce fichier est appelé directement

const SALT_ROUNDS = 10; // Nombre de tours de salage pour bcrypt (un bon compromis)

// --- Logique d'Inscription (Sign Up) ---
export const signup = async (req: Request, res: Response) => {
  // Récupère les données attendues du corps de la requête
  const { firstName, lastName, email, password, role, phoneNumber, position, department, companyId, avatarUrl, bio, skills, certifications, languages } = req.body;

  // Validation basique : vérifie les champs obligatoires pour une inscription de base
  if (!firstName || !lastName || !email || !password || !role) {
    console.log('❌ Signup validation failed: Missing required fields.');
    return res.status(400).json({ message: 'Missing required fields: firstName, lastName, email, password, role.' });
  }

  // TODO: Ajouter une validation plus robuste des données (format email, force mot de passe, rôle valide, etc.)
  // Exemple de validation de rôle simple :
  const validRoles = ['admin', 'supervisor', 'team_member', 'client_contact']; // Définissez vos rôles valides ici
   if (!validRoles.includes(role)) {
       console.log('❌ Signup validation failed: Invalid role specified:', role);
       return res.status(400).json({ message: `Invalid role. Allowed roles are: ${validRoles.join(', ')}.` });
   }

  // TODO: Gérer la logique `companyId` : trouver une entreprise existante ou en créer une si nécessaire.
  // Pour l'instant, on l'inclut si présent dans la requête, mais sans validation FK côté application.

  try {
    // 1. Vérifier si un utilisateur avec cet email existe déjà
    const existingUser = await prisma.user.findUnique({
      where: { email },
    });

    if (existingUser) {
       console.log('❌ Signup failed: Email already in use:', email);
      return res.status(409).json({ message: 'Email already in use.' }); // 409 Conflict
    }

    // 2. Hacher le mot de passe avant de le stocker
    const passwordHash = await bcrypt.hash(password, SALT_ROUNDS);

    // 3. Créer le nouvel utilisateur dans la base de données
    const newUser = await prisma.user.create({
      data: {
        firstName,
        lastName,
        email,
        passwordHash, // Stocke le hash, pas le mot de passe en clair
        role,
        phoneNumber, // Peut être null si optionnel dans le schéma
        position,    // Peut être null
        department,  // Peut être null
        companyId,   // Peut être null
        // joinDate est définie par défaut dans le schéma (@default(now()))
        avatarUrl, // Peut être null
        bio,       // Peut être null

        // Gérer les listes (skills, certifications, languages)
        // Si votre MySQL supporte JSON (>= 5.7) et votre schéma est String[]:
        skills: skills || [], // Assurez-vous que c'est un tableau, même vide
        certifications: certifications || [],
        languages: languages || [],
        // Si votre MySQL est < 5.7 et votre schéma est String?:
        // skills: (skills as string[] | undefined)?.join(',') || '', // Convertir tableau en chaîne délimitée par virgules
        // certifications: (certifications as string[] | undefined)?.join(',') || '',
        // languages: (languages as string[] | undefined)?.join(',') || '',
      },
      // Sélectionne les champs à retourner, EXCLUANT le passwordHash pour la sécurité
      select: {
        id: true,
        firstName: true,
        lastName: true,
        email: true,
        role: true,
        phoneNumber: true,
        position: true,
        department: true,
        companyId: true,
        joinDate: true,
        avatarUrl: true,
        bio: true,
        skills: true, // Retourne le type stocké (tableau ou chaîne)
        certifications: true,
        languages: true,
        // Ajoutez d'autres champs nécessaires au frontend
      },
    });

    console.log(`✅ User created successfully: ${newUser.email} (${newUser.role}). ID: ${newUser.id}`);
    // Réponse de succès (statut 201 Created)
    res.status(201).json({ message: 'User created successfully.', user: newUser });

  } catch (error: any) {
    console.error('❌ Signup error:', error);
    // Gérer les erreurs spécifiques de Prisma si nécessaire (ex: violation de contrainte unique autre que l'email)
    res.status(500).json({ message: 'Internal server error during signup.', error: error.message });
  }
};

// --- Logique de Connexion (Sign In) ---
export const signin = async (req: Request, res: Response) => {
  const { email, password, role } = req.body; // Récupère email et mot de passe (et optionnellement le rôle si le frontend l'envoie)

  // Validation basique
  if (!email || !password) {
    console.log('❌ Signin validation failed: Email and password are required.');
    return res.status(400).json({ message: 'Email and password are required.' });
  }

  try {
    // 1. Trouver l'utilisateur par email
    const user = await prisma.user.findUnique({
      where: { email },
    });

    // Si l'utilisateur n'existe pas OU si le mot de passe est incorrect
    // Utilisez le MÊME message d'erreur pour les deux cas afin de ne pas donner d'indices aux attaquants.
    if (!user || !(await bcrypt.compare(password, user.passwordHash))) {
      console.log(`❌ Signin failed for email "${email}": Invalid credentials.`);
      return res.status(401).json({ message: 'Invalid credentials.' }); // 401 Unauthorized
    }

    // TODO: Si votre logique frontend l'exige, vous pourriez ajouter une vérification ici
    // pour s'assurer que l'utilisateur a bien le rôle attendu.
    // Ex: if (role && user.role !== role) {
    //    console.log(`❌ Signin failed for user ${user.email}: Attempted login with role "${role}" but actual role is "${user.role}".`);
    //    return res.status(403).json({ message: 'Forbidden role for this user.' }); // 403 Forbidden
    // }
    // Si le frontend n'envoie pas le rôle, sautez cette vérification.

    // 2. Générer un JSON Web Token (JWT)
    const token = jwt.sign(
      { id: user.id, role: user.role }, // Le payload minimal : ID unique et rôle
      process.env.JWT_SECRET as string, // La clé secrète (assurez-vous qu'elle est définie dans .env)
      { expiresIn: '1d' } // Le token expire après 1 jour
    );

    console.log(`✅ Signin successful for user: ${user.email} (${user.role}). ID: ${user.id}. Token generated.`);

    // 3. Renvoyer le token et des informations utilisateur basiques au frontend
    res.status(200).json({
      message: 'Login successful.',
      token, // Le token est envoyé au frontend (souvent stocké en Local Storage ou dans un cookie JS géré par le frontend)
      user: { // Informations basiques de l'utilisateur (sans le hash du mot de passe)
        id: user.id,
        firstName: user.firstName,
        lastName: user.lastName,
        email: user.email,
        role: user.role,
        avatarUrl: user.avatarUrl, // Inclure le chemin de l'image de profil
        companyId: user.companyId, // Inclure l'ID de l'entreprise
        phoneNumber: user.phoneNumber, // Inclure le numéro de téléphone
        position: user.position,
        department: user.department,
        joinDate: user.joinDate,
        bio: user.bio,
        skills: user.skills, // Selon le schéma (tableau ou chaîne)
        certifications: user.certifications,
        languages: user.languages,
        // Ajoutez d'autres champs ici si le frontend en a besoin immédiatement après la connexion
      },
    });

  } catch (error: any) {
    console.error('❌ Signin error:', error);
    res.status(500).json({ message: 'Internal server error during signin.', error: error.message });
  }
};

// TODO: Ajouter d'autres contrôleurs liés à l'auth ici (ex: logout, forgotPassword, resetPassword, verifyEmail, etc.)
