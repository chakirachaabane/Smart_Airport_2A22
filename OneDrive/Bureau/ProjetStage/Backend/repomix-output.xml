// src/middleware/authMiddleware.ts
import { Request, Response, NextFunction } from 'express';
import jwt from 'jsonwebtoken';
import 'dotenv/config'; // Charge les variables d'environnement

// IMPORTANT: Étend l'interface Request d'Express pour ajouter la propriété 'user'
// Cela permet à TypeScript de savoir que req.user existe après le middleware
declare global {
  namespace Express {
    interface Request {
      user?: {
        id: string; // L'ID de l'utilisateur tel que stocké dans le payload du JWT
        role: string; // Le rôle de l'utilisateur tel que stocké dans le payload du JWT
        // Ajoutez ici d'autres propriétés si vous les incluez dans le payload JWT et en avez besoin dans req.user
      };
    }
  }
}

export const authenticateToken = (req: Request, res: Response, next: NextFunction) => {
  // Récupère le token du header Authorization (Format standard: Bearer TOKEN)
  const authHeader = req.headers['authorization'];
  const token = authHeader && authHeader.split(' ')[1]; // Sépare "Bearer" du token

  // Si aucun token n'est présent, l'utilisateur n'est pas authentifié
  if (token == null) {
    // console.log("❌ Authentication failed: No token provided."); // Log pour le debug serveur
    return res.sendStatus(401); // 401 Unauthorized
  }

  // Vérifie la validité du token en utilisant la clé secrète
  jwt.verify(token, process.env.JWT_SECRET as string, (err, userPayload) => {
    if (err) {
      // console.error("❌ JWT verification failed:", err.message); // Log pour le debug serveur
      // Si la vérification échoue (token expiré, signature invalide, etc.)
      return res.sendStatus(403); // 403 Forbidden
    }

    // Si le token est valide, le payload (userPayload) est décodé.
    // Attache le payload décodé à l'objet request pour qu'il soit disponible dans les gestionnaires de route suivants
    // On le cast au type défini dans le 'declare global'
    req.user = userPayload as { id: string; role: string; };

    // console.log(`✅ Token authenticated for user ID: ${req.user.id}, role: ${req.user.role}`); // Log pour le debug serveur

    // Passe au middleware ou au gestionnaire de route suivant
    next();
  });
};

// Exemple de middleware d'autorisation basé sur les rôles (RBAC)
// Utilisez-le APRÈS authenticateToken pour restreindre l'accès à certains rôles
export const authorize = (allowedRoles: string[]) => {
    return (req: Request, res: Response, next: NextFunction) => {
         // S'assure que authenticateToken a déjà été exécuté et que req.user est défini
        if (!req.user) {
            // Ceci ne devrait pas arriver si le middleware est bien chaîné (authenticateToken -> authorize -> route handler)
            console.error("❌ Authorization check failed: req.user is undefined. Is authenticateToken missing?");
            return res.sendStatus(500); // Erreur interne si le middleware n'est pas chaîné correctement
        }

        // Vérifie si le rôle de l'utilisateur est dans la liste des rôles autorisés
        if (allowedRoles.includes(req.user.role)) {
            // console.log(`✅ Authorization successful for user ID ${req.user.id}: Role "${req.user.role}" is allowed.`);
            next(); // Rôle autorisé, passer au gestionnaire de route
        } else {
            // console.log(`❌ Authorization failed for user ID ${req.user.id}: Role "${req.user.role}" not in allowed roles [${allowedRoles.join(', ')}].`);
            return res.sendStatus(403); // 403 Forbidden (accès refusé)
        }
    };
};
